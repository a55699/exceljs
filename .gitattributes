# Normalize text files to LF in the repo and in the working tree on every OS,
# so Windows checkouts (core.autocrlf=true) match prettier's endOfLine: lf.
* text=auto eol=lf

# Binary files: never convert line endings or diff as text.
*.xlsx binary
*.xls binary
*.numbers binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
